<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layoutDirection="ltr">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/permissionMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="32dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/perm_needed"
            android:textColor="@color/text"
            android:textDirection="rtl"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/focusRing"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:src="@drawable/bg_focus_ring"
            android:visibility="invisible" />

        <!-- الشريط العلوي -->
        <LinearLayout
            android:id="@+id/topArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_top_gradient"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnFlip"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@string/cd_flip"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flip" />

                <ImageButton
                    android:id="@+id/btnTemplate"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@string/cd_template"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_template" />

                <ImageButton
                    android:id="@+id/btnGlare"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@string/cd_glare"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sun" />

                <ImageButton
                    android:id="@+id/btnFlash"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@string/cd_flash"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flash_off" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@string/cd_menu"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/zoom1"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="1x"
                    android:textColor="@color/chip_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/zoom2"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="2x"
                    android:textColor="@color/chip_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/zoom3"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="3x"
                    android:textColor="@color/chip_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- الشريط السفلي -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_gradient"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:gravity="right"
                android:maxLines="3"
                android:shadowColor="#000000"
                android:shadowRadius="3"
                android:textColor="@color/text"
                android:textDirection="rtl"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="@string/label_fat"
                        android:textColor="@color/text_dim"
                        android:textDirection="rtl"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etFat"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center"
                        android:hint="@string/hint_fat"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLength="24"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="@string/label_zone"
                        android:textColor="@color/text_dim"
                        android:textDirection="rtl"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etZone"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center"
                        android:hint="@string/hint_zone"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLength="24"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:paddingTop="6dp">

                <ImageButton
                    android:id="@+id/btnGallery"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="30dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@string/cd_gallery"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gallery" />

                <View
                    android:id="@+id/shutter"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter"
                    android:clickable="true"
                    android:contentDescription="@string/cd_shutter"
                    android:focusable="true" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/white"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- القائمة الجانبية -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel_solid"
        android:clickable="true"
        android:focusable="true"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/bg_card" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textAlignment="viewStart"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_subtitle"
                android:textAlignment="viewStart"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />

        <TextView
            android:id="@+id/menuGallery"
            style="@style/DrawerItem"
            android:drawableStart="@drawable/ic_gallery"
            android:text="@string/menu_gallery" />

        <TextView
            android:id="@+id/menuAboutUs"
            style="@style/DrawerItem"
            android:drawableStart="@drawable/ic_people"
            android:text="@string/menu_about_us" />

        <TextView
            android:id="@+id/menuAboutApp"
            style="@style/DrawerItem"
            android:drawableStart="@drawable/ic_info"
            android:text="@string/menu_about_app" />

        <TextView
            android:id="@+id/menuExit"
            style="@style/DrawerItem"
            android:drawableStart="@drawable/ic_exit"
            android:text="@string/menu_exit" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
